# Local-only configuration. Never commit .env or broker/API secrets.
MT5_PATH=
SYMBOLS=EURUSDm,GBPUSDm,BTCUSDm,XAUUSDm

# Start safely in PAPER mode.
TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# For intentional live execution, set both:
# TRADING_MODE=LIVE
# ALLOW_LIVE_TRADING=true

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

RISK_PER_TRADE=0.25
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=80
MIN_AI_CONFIDENCE=70
LOOP_SECONDS=5
MAGIC_NUMBER=260001
DB_PATH=autobot.db
