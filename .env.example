# LOCAL ONLY. Never commit .env or any broker/API secret.
MT5_PATH=
SYMBOLS=EURUSDm,GBPUSDm,BTCUSDm,XAUUSDm

TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# OpenAI-compatible LLM gateway
AI_PROVIDER=freellmapi
AI_BASE_URL=http://127.0.0.1:3001/v1
AI_API_KEY=
AI_MODEL=auto
AI_TIMEOUT_SECONDS=35

# Optional direct DeepSeek fallback
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

RISK_PER_TRADE=0.25
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=80
MIN_AI_CONFIDENCE=70
ENTRY_COOLDOWN_SECONDS=60
LOOP_SECONDS=5
MAGIC_NUMBER=260001
DB_PATH=autobot.db
