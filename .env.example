# LOCAL ONLY. Never commit .env or any API secret.
# MT5 broker login/password/server are intentionally NOT configured here.
# The bot uses whichever account is already logged in inside MetaTrader 5.
SYMBOLS=EURUSDm,GBPUSDm,BTCUSDm,XAUUSDm

TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Online OpenAI open-weight model via OpenRouter free endpoint.
# Create one OpenRouter API key and keep it only in your local .env.
AI_PROVIDER=freellmapi
AI_BASE_URL=http://127.0.0.1:31415/v1
AI_API_KEY=freellmapi-bc211c6f5f87ac7a0217b9377ff28670ea3bd86b01f17ef6
AI_MODEL=auto
AI_TIMEOUT_SECONDS=35

RISK_PER_TRADE=0.25
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=80
MIN_AI_CONFIDENCE=70
ENTRY_COOLDOWN_SECONDS=60
LOOP_SECONDS=5
MAGIC_NUMBER=260001
DB_PATH=autobot.db
